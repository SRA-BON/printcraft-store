# MongoDB Atlas or local connection string (required on Render)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# Render sets PORT automatically; local default is 5000
# PORT=5000

# Comma-separated frontend origins (your Vercel URL). Also allows *.vercel.app automatically.
CLIENT_URL=https://your-app.vercel.app

NODE_ENV=production
